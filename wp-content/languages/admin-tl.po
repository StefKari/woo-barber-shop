msgctxt "date/time"
msgid "On"
msgstr "Sa"

#: wp-admin/includes/privacy-tools.php:388
msgctxt "website URL"
msgid "At URL"
msgstr "Sa URL"

#: wp-admin/includes/privacy-tools.php:384
msgctxt "website name"
msgid "For site"
msgstr "Para sa site"

#: wp-admin/includes/privacy-tools.php:380
msgctxt "email address"
msgid "Report generated for"
msgstr "Ulat na nabuo para sa"

