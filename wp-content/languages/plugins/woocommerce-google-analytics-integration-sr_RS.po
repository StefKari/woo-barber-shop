msgid "Support"
msgstr "Подршка"

#: woocommerce-google-analytics-integration.php:120
msgid "Settings"
msgstr "Подешавања"

#. Author URI of the plugin
#: woocommerce-google-analytics-integration.php
msgid "https://woocommerce.com"
msgstr "https://woocommerce.com"

#: includes/class-wc-google-analytics.php:221
msgid "Please note, for transaction tracking to work properly, you will need to use a payment gateway that redirects the customer back to a WooCommerce order received/thank you page."
msgstr "Имајте на уму да је за исправно праћење трансакција потребно да користите посредника плаћања који купца враћа на WooCommerce страницу примљене поруџбине/захвалнице."

#: includes/class-wc-google-analytics.php:215
msgid "Please allow Google Analytics 24 hours to start displaying results."
msgstr "Дајте Google Analytics-у 24 сата да почне да приказује резултате."

#: includes/class-wc-google-analytics.php:181
msgid "Product Clicks from Listing Pages"
msgstr "Притисци на производе са страница списка"

#: includes/class-wc-google-analytics.php:188
msgid "Product Detail Views"
msgstr "Прегледи детаља производа"

