u043e \u0437\u0430\u043f\u0435\u0442\u0435 (,) \u0437\u0430 \u0434\u0435\u0446\u0438\u043c\u0430\u043b\u043d\u0435 \u0431\u0440\u043e\u0458\u0435\u0432\u0435 (\u043d\u043f\u0440. 2.5 \u0443\u043c\u0435\u0441\u0442\u043e 2,5)"],"Invalid numeric value":["\u041d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u0430 \u0431\u0440\u043e\u0458\u0447\u0430\u043d\u0430 \u0432\u0440\u0435\u0434\u043d\u043e\u0441\u0442"],"Action find text is required":["\u0422\u0435\u043a\u0441\u0442 \u0437\u0430 \u043f\u0440\u043e\u043d\u0430\u043b\u0430\u0436\u0435\u045a\u0435 \u0443 \u0440\u0430\u0434\u045a\u0438 \u0458\u0435 \u043e\u0431\u0430\u0432\u0435\u0437\u0430\u043d"],"Action attribute is required":["\u0410\u0442\u0440\u0438\u0431\u0443\u0442 \u0440\u0430\u0434\u045a\u0435 \u0458\u0435 \u043e\u0431\u0430\u0432\u0435\u0437\u0430\u043d"],"Condition is required":["\u0423\u0441\u043b\u043e\u0432 \u0458\u0435 \u043e\u0431\u0430\u0432\u0435\u0437\u0430\u043d"],"Value is required for this condition":["\u0417\u0430 \u043e\u0432\u0430\u0458 \u0443\u0441\u043b\u043e\u0432 \u0432\u0440\u0435\u0434\u043d\u043e\u0441\u0442 \u0458\u0435 \u043e\u0431\u0430\u0432\u0435\u0437\u043d\u0430"],"Attribute is required":["\u0410\u0442\u0440\u0438\u0431\u0443\u0442 \u0458\u0435 \u043e\u0431\u0430\u0432\u0435\u0437\u0430\u043d"]}},"comment":{"reference":"dist\/apps\/filters-rules-builder\/index.DvLyimBe.js"}}