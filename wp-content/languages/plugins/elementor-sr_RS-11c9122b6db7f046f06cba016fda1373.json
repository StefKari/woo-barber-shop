u043f\u043e\u043d\u0435\u043d\u0442\u0443. \u041e\u0431\u0440\u0430\u0442\u0438\u0442\u0435 \u0441\u0435 \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u0443 \u0434\u0430 \u0434\u043e\u0434\u0430 \u0441\u0432\u043e\u0458\u0441\u0442\u0432\u0430."],"Edit the component to add properties, manage them or update the design across all instances.":["\u0423\u0440\u0435\u0434\u0438\u0442\u0435 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0443 \u0434\u0430 \u0431\u0438\u0441\u0442\u0435 \u0434\u043e\u0434\u0430\u043b\u0438 \u0441\u0432\u043e\u0458\u0441\u0442\u0432\u0430, \u0443\u043f\u0440\u0430\u0432\u0459\u0430\u043b\u0438 \u045a\u0438\u043c\u0430 \u0438\u043b\u0438 \u0430\u0436\u0443\u0440\u0438\u0440\u0430\u043b\u0438 \u0434\u0438\u0437\u0430\u0458\u043d \u0443 \u0441\u0432\u0438\u043c \u043f\u0440\u0438\u043c\u0435\u0440\u0446\u0438\u043c\u0430."],"Right-click any div-block or flexbox on your canvas or structure and select \"Create component\"":["\u0414\u0435\u0441\u043d\u0438\u043c \u0442\u0430\u0441\u0442\u0435\u0440\u043e\u043c \u043f\u0440\u0438\u0442\u0438\u0441\u043d\u0438\u0442\u0435 \u0431\u0438\u043b\u043e \u043a\u043e\u0458\u0438 div-block \u0438\u043b\u0438 flexbox \u043d\u0430 \u043f\u043b\u0430\u0442\u043d\u0443 \u0438\u043b\u0438 \u0443 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0438 \u0438 \u0438\u0437\u0430\u0431\u0435\u0440\u0438\u0442\u0435 \u201e\u041d\u0430\u043f\u0440\u0430\u0432\u0438 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0443\u201c"],"Create your first one:":["\u041d\u0430\u043f\u0440\u0430\u0432\u0438\u0442\u0435 \u043f\u0440\u0432\u0443:"],"Learn more about components":["\u0421\u0430\u0437\u043d\u0430\u0458\u0442\u0435 \u0432\u0438\u0448\u0435 \u043e \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0430\u043c\u0430"],"With your current role, you cannot create components. Contact an administrator to create one.":["\u0421\u0430 \u0432\u0430\u0448\u043e\u043c \u0442\u0440\u0435\u043d\u0443\u0442\u043d\u043e\u043c \u0443\u043b\u043e\u0433\u043e\u043c \u043d\u0435 \u043c\u043e\u0436\u0435\u0442\u0435 \u0434\u0430 \u043f\u0440\u0430\u0432\u0438\u0442\u0435 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0435. \u041e\u0431\u0440\u0430\u0442\u0438\u0442\u0435 \u0441\u0435 \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u0443 \u0434\u0430 \u0458\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u0438."],"Create once, use everywhere.":["\u041d\u0430\u043f\u0440\u0430\u0432\u0438\u0442\u0435 \u0458\u0435\u0434\u043d\u043e\u043c, \u043a\u043e\u0440\u0438\u0441\u0442\u0438\u0442\u0435 \u0441\u0432\u0443\u0434\u0430."],"Components are reusable blocks that sync across your site.":["\u041a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0435 \u0441\u0443 \u0431\u043b\u043e\u043a\u043e\u0432\u0438 \u0437\u0430 \u0432\u0438\u0448\u0435\u043a\u0440\u0430\u0442\u043d\u0443 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0443 \u043a\u043e\u0458\u0438 \u0441\u0435 \u0443\u0441\u043a\u043b\u0430\u0452\u0443\u0458\u0443 \u043d\u0430 \u0446\u0435\u043b\u043e\u043c \u0441\u0430\u0458\u0442\u0443."],"No components yet":["\u0408\u043e\u0448 \u043d\u0435\u043c\u0430 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0438"],"Can't add this component - components that contain each other can't be nested.":["\u041d\u0438\u0458\u0435 \u043c\u043e\u0433\u0443\u045b\u0435 \u0434\u043e\u0434\u0430\u0442\u0438 \u043e\u0432\u0443 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0443 - \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0435 \u043a\u043e\u0458\u0435 \u0441\u0430\u0434\u0440\u0436\u0435 \u0458\u0435\u0434\u043d\u0430 \u0434\u0440\u0443\u0433\u0443 \u043d\u0435 \u043c\u043e\u0433\u0443 \u0431\u0438\u0442\u0438 \u0443\u0433\u043d\u0435\u0436\u0452\u0435\u043d\u0435."],"Edit Component":["\u0423\u0440\u0435\u0434\u0438 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0443"],"You can wait for them to finish or reach out to coordinate your changes together.":["\u041c\u043e\u0436\u0435\u0442\u0435 \u0441\u0430\u0447\u0435\u043a\u0430\u0442\u0438 \u0434\u0430 \u0437\u0430\u0432\u0440\u0448\u0435 \u0438\u043b\u0438 \u0438\u043c \u0441\u0435 \u043e\u0431\u0440\u0430\u0442\u0438\u0442\u0438 \u0434\u0430 \u0437\u0430\u0458\u0435\u0434\u043d\u043e \u0443\u0441\u043a\u043b\u0430\u0434\u0438\u0442\u0435 \u0438\u0437\u043c\u0435\u043d\u0435."],"%s is currently editing this document":["%s \u0442\u0440\u0435\u043d\u0443\u0442\u043d\u043e \u0443\u0440\u0435\u0452\u0443\u0458\u0435 \u043e\u0432\u0430\u0458 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442"],"Components":["\u041a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0435"],"Clear & try again":["\u041e\u0447\u0438\u0441\u0442\u0438 \u0438 \u043f\u043e\u043a\u0443\u0448\u0430\u0458 \u043f\u043e\u043d\u043e\u0432\u043e"],"Try something else.":["\u041f\u043e\u043a\u0443\u0448\u0430\u0458\u0442\u0435 \u043d\u0435\u0448\u0442\u043e \u0434\u0440\u0443\u0433\u043e."],"Sorry, nothing matched":["\u041d\u0430\u0436\u0430\u043b\u043e\u0441\u0442, \u043d\u0438\u0448\u0442\u0430 \u0441\u0435 \u043d\u0435 \u043f\u043e\u0434\u0443\u0434\u0430\u0440\u0430"],"Upgrade now":["\u041d\u0430\u0434\u043e\u0433\u0440\u0430\u0434\u0438 \u0441\u0430\u0434\u0430"],"Upgrade Now":["\u041d\u0430\u0434\u043e\u0433\u0440\u0430\u0434\u0438 \u0441\u0430\u0434\u0430"],"Search":["\u041f\u0440\u0435\u0442\u0440\u0430\u0433\u0430"],"Update Elementor Pro":["\u0410\u0436\u0443\u0440\u0438\u0440\u0430\u0458 Elementor Pro"],"Edit %s":["\u0423\u0440\u0435\u0434\u0438 %s"],"Close":["\u0417\u0430\u0442\u0432\u043e\u0440\u0438"],"Update Now":["\u0410\u0436\u0443\u0440\u0438\u0440\u0430\u0458 \u0441\u0430\u0434\u0430"]}},"comment":{"reference":"assets\/js\/packages\/editor-components\/editor-components.js"}}