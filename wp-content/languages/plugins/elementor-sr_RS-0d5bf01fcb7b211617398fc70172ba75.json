0438 \u0441\u0430 \u043f\u0430\u043d\u0435\u043b\u0430 \u0437\u0430 \u0443\u0440\u0435\u0452\u0438\u0432\u0430\u045a\u0435 \u0438 \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0458\u0430\u043b\u043d\u043e \u043c\u043e\u0436\u0435 \u0443\u0442\u0438\u0446\u0430\u0442\u0438 \u043d\u0430 \u0432\u0430\u0448 \u0440\u0430\u0441\u043f\u043e\u0440\u0435\u0434 \u0438\u043b\u0438 \u0444\u0440\u043e\u043d\u0442-\u0435\u043d\u0434."],"Elementor Pro":["Elementor Pro"],"Elementor Pro Elements":["Elementor Pro \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0438"],"Usage":["\u041a\u043e\u0440\u0438\u0448\u045b\u0435\u045a\u0435"],"Element":["\u0415\u043b\u0435\u043c\u0435\u043d\u0442"],"No elements found.":["\u041d\u0438\u0458\u0435 \u043f\u0440\u043e\u043d\u0430\u0452\u0435\u043d \u043d\u0438\u0458\u0435\u0434\u0430\u043d \u0435\u043b\u0435\u043c\u0435\u043d\u0442."],"Enable All":["\u0423\u043a\u0459\u0443\u0447\u0438 \u0441\u0432\u0435"],"Deactivate Unused Elements":["\u0418\u0441\u043a\u0459\u0443\u0447\u0438\u0442\u0435 \u043d\u0435\u0438\u0441\u043a\u043e\u0440\u0438\u0448\u045b\u0435\u043d\u0435 \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0435"],"Scan Element Usage":["\u0421\u043a\u0435\u043d\u0438\u0440\u0430\u0458 \u043a\u043e\u0440\u0438\u0448\u045b\u0435\u045a\u0435 \u0435\u043b\u0435\u043c\u0435\u043d\u0430\u0442\u0430"],"Deactivating widgets here will remove them from both the Elementor Editor and your website, which can cause changes to your overall layout, design and what visitors see.":["\u0418\u0441\u043a\u0459\u0443\u0447\u0438\u0432\u0430\u045a\u0435 \u0432\u0438\u045f\u0435\u0442\u0430 \u043e\u0432\u0434\u0435 \u0443\u043a\u043b\u043e\u043d\u0438\u045b\u0435 \u0438\u0445 \u0438 \u0438\u0437 Elementor \u0443\u0440\u0435\u0452\u0438\u0432\u0430\u0447\u0430 \u0438 \u0441\u0430 \u0432\u0430\u0448\u0435\u0433 \u0432\u0435\u0431 \u0441\u0430\u0458\u0442\u0430, \u0448\u0442\u043e \u043c\u043e\u0436\u0435 \u0438\u0437\u0430\u0437\u0432\u0430\u0442\u0438 \u043f\u0440\u043e\u043c\u0435\u043d\u0435 \u0443\u043a\u0443\u043f\u043d\u043e\u0433 \u0440\u0430\u0441\u043f\u043e\u0440\u0435\u0434\u0430, \u0434\u0438\u0437\u0430\u0458\u043d\u0430 \u0438 \u043e\u043d\u043e\u0433\u0430 \u0448\u0442\u043e \u043f\u043e\u0441\u0435\u0442\u0438\u043e\u0446\u0438 \u0432\u0438\u0434\u0435."],"Before you continue:":["\u041f\u0440\u0435 \u043d\u0435\u0433\u043e \u0448\u0442\u043e \u043d\u0430\u0441\u0442\u0430\u0432\u0438\u0442\u0435:"],"Here's where you can fine-tune Elementor to your workflow. Disable elements you don't use for a cleaner interface, more focused creative experience, and improved performance.":["\u041e\u0432\u0434\u0435 \u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u0440\u0438\u043b\u0430\u0433\u043e\u0434\u0438\u0442\u0438 Elementor \u0441\u0432\u043e\u043c \u043d\u0430\u0447\u0438\u043d\u0443 \u0440\u0430\u0434\u0430. \u0418\u0441\u043a\u0459\u0443\u0447\u0438\u0442\u0435 \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0435 \u043a\u043e\u0458\u0435 \u043d\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438\u0442\u0435 \u0440\u0430\u0434\u0438 \u0447\u0438\u0441\u0442\u0438\u0458\u0435\u0433 \u0441\u0443\u0447\u0435\u0459\u0430, \u0443\u0441\u0440\u0435\u0434\u0441\u0440\u0435\u0452\u0435\u043d\u0438\u0458\u0435\u0433 \u043a\u0440\u0435\u0430\u0442\u0438\u0432\u043d\u043e\u0433 \u0438\u0441\u043a\u0443\u0441\u0442\u0432\u0430 \u0438 \u0431\u043e\u0459\u0438\u0445 \u043f\u0435\u0440\u0444\u043e\u0440\u043c\u0430\u043d\u0441\u0438."],"All Plugins":["\u0421\u0432\u0438 \u0434\u043e\u0434\u0430\u0446\u0438"],"times":["\u043f\u0443\u0442\u0430"],"Sure you want to save these changes?":["\u0414\u0430 \u043b\u0438 \u0441\u0438\u0433\u0443\u0440\u043d\u043e \u0436\u0435\u043b\u0438\u0442\u0435 \u0434\u0430 \u0441\u0430\u0447\u0443\u0432\u0430\u0442\u0435 \u043e\u0432\u0435 \u0438\u0437\u043c\u0435\u043d\u0435?"],"Unleash the full power of Elementor's features and web creation tools.":["\u0418\u0441\u043a\u043e\u0440\u0438\u0441\u0442\u0438\u0442\u0435 \u043f