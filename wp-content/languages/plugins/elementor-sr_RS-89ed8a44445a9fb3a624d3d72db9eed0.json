{"translation-revision-date":"2026-10-08 12:03:51+0000","generator":"GlotPress\/4.1.0","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","plural-forms":"nplurals=3; plural=(n % 10 == 1 && n % 100 != 11) ? 0 : ((n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14)) ? 1 : 2);","lang":"sr_RS"},"Defaults":["\u041f\u043e\u0434\u0440\u0430\u0437\u0443\u043c\u0435\u0432\u0430\u043d\u043e"],"Your design system import failed":["\u0423\u0432\u043e\u0437 \u0432\u0430\u0448\u0435\u0433 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0434\u0438\u0437\u0430\u0458\u043d\u0430 \u043d\u0438\u0458\u0435 \u0443\u0441\u043f\u0435\u043e"],"Design system imported":["\u0421\u0438\u0441\u0442\u0435\u043c \u0434\u0438\u0437\u0430\u0458\u043d\u0430 \u0458\u0435 \u0443\u0432\u0435\u0437\u0435\u043d"],"Import in Progress. You will be notified when the import is complete.":["\u0423\u0432\u043e\u0437 \u0458\u0435 \u0443 \u0442\u043e\u043a\u0443. \u0411\u0438\u045b\u0435\u0442\u0435 \u043e\u0431\u0430\u0432\u0435\u0448\u0442\u0435\u043d\u0438 \u043a\u0430\u0434\u0430 \u0441\u0435 \u0443\u0432\u043e\u0437 \u0437\u0430\u0432\u0440\u0448\u0438."],"Learn how design system imports work":["\u0421\u0430\u0437\u043d\u0430\u0458\u0442\u0435 \u043a\u0430\u043a\u043e \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0438\u0448\u0435 \u0443\u0432\u043e\u0437 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0434\u0438\u0437\u0430\u0458\u043d\u0430"],"zip (max. %dMB)":["zip (\u043d\u0430\u0458\u0432\u0438\u0448\u0435 %dMB)"],"Design system file dropzone":["\u0417\u043e\u043d\u0430 \u0437\u0430 \u0438\u0441\u043f\u0443\u0448\u0442\u0430\u045a\u0435 \u0434\u0430\u0442\u043e\u0442\u0435\u043a\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0434\u0438\u0437\u0430\u0458\u043d\u0430"],"Import Design System":["\u0423\u0432\u0435\u0437\u0438 \u0441\u0438\u0441\u0442\u0435\u043c \u0434\u0438\u0437\u0430\u0458\u043d\u0430"],"How to handle conflicts with existing variables or classes?":["\u041a\u0430\u043a\u043e \u0440\u0435\u0448\u0438\u0442\u0438 \u0441\u0443\u043a\u043e\u0431\u0435 \u0441\u0430 \u043f\u043e\u0441\u0442\u043e\u0458\u0435\u045b\u0438\u043c \u043f\u0440\u043e\u043c\u0435\u043d\u0459\u0438\u0432\u0430\u043c\u0430 \u0438\u043b\u0438 \u043a\u043b\u0430\u0441\u0430\u043c\u0430?"],"Existing variables and classes will not change.":["\u041f\u043e\u0441\u0442\u043e\u0458\u0435\u045b\u0435 \u043f\u0440\u043e\u043c\u0435\u043d\u0459\u0438\u0432\u0435 \u0438 \u043a\u043b\u0430\u0441\u0435 \u0441\u0435 \u043d\u0435\u045b\u0435 \u043f\u0440\u043e\u043c\u0435\u043d\u0438\u0442\u0438."],"Keep existing values":["\u0417\u0430\u0434\u0440\u0436\u0438 \u043f\u043e\u0441\u0442\u043e\u0458\u0435\u045b\u0435 \u0432\u0440\u0435\u0434\u043d\u043e\u0441\u0442\u0438"],"Imported design system values will overwrite existing variables and classes.":["\u0423\u0432\u0435\u0437\u0435\u043d\u0435 \u0432\u0440\u0435\u0434\u043d\u043e\u0441\u0442\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0434\u0438\u0437\u0430\u0458\u043d\u0430 \u043f\u0440\u0435\u043f\u0438\u0441\u0430\u045b\u0435 \u043f\u043e\u0441\u0442\u043e\u0458\u0435\u045b\u0435 \u043f\u0440\u043e\u043c\u0435\u043d\u0459\u0438\u0432\u0435 \u0438 \u043a\u043b\u0430\u0441\u0435."],"Replace existing values":["\u0417\u0430\u043c\u0435\u043d\u0438 \u043f\u043e\u0441\u0442\u043e\u0458\u0435\u045b\u0435 \u0432\u0440\u0435\u0434\u043d\u043e\u0441\u0442\u0438"],"Your design system export failed":["\u0418\u0437\u0432\u043e\u0437 \u0432\u0430\u0448\u0435\u0433 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0434\u0438\u0437\u0430\u0458\u043d\u0430 \u043d\u0438\u0458\u0435 \u0443\u0441\u043f\u0435\u043e"],"Design system exported":["\u0421\u0438\u0441\u0442\u0435\u043c \u0434\u0438\u0437\u0430\u0458\u043d\u0430 \u0458\u0435 \u0438\u0437\u0432\u0435\u0437\u0435\u043d"],"Export in progress. Your file will download when it\u2019s ready.":["\u0418\u0437\u0432\u043e\u0437 \u0458\u0435 \u0443 \u0442\u043e\u043a\u0443. \u0412\u0430