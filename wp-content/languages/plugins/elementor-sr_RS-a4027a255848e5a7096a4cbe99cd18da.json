u0430\u043f\u0440\u0430\u0432\u0438\u0442\u0435 \u0432\u0430\u0440\u0438\u0458\u0430\u0446\u0438\u0458\u0435 \u0438\u0437 \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0435 \u0448\u0430\u0431\u043b\u043e\u043d\u0430"],"prompt library":["\u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0430 \u0443\u043f\u0443\u0442\u0441\u0442\u0430\u0432\u0430"],"This result includes an Elementor Pro widget that's not available with your current plan. Upgrade to use all the widgets in this result.":["\u041e\u0432\u0430\u0458 \u0440\u0435\u0437\u0443\u043b\u0442\u0430\u0442 \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0435 Elementor Pro \u0432\u0438\u045f\u0435\u0442 \u043a\u043e\u0458\u0438 \u043d\u0438\u0458\u0435 \u0434\u043e\u0441\u0442\u0443\u043f\u0430\u043d \u0443 \u0432\u0430\u0448\u0435\u043c \u0442\u0440\u0435\u043d\u0443\u0442\u043d\u043e\u043c \u043f\u043b\u0430\u043d\u0443. \u041d\u0430\u0434\u043e\u0433\u0440\u0430\u0434\u0438\u0442\u0435 \u0434\u0430 \u0431\u0438\u0441\u0442\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438\u043b\u0438 \u0441\u0432\u0435 \u0432\u0438\u045f\u0435\u0442\u0435 \u0443 \u043e\u0432\u043e\u043c \u0440\u0435\u0437\u0443\u043b\u0442\u0430\u0442\u0443."],"AI Variation":["\u0412\u0418 \u0432\u0430\u0440\u0438\u0458\u0430\u0446\u0438\u0458\u0430"],"Generate variations with AI":["\u041d\u0430\u043f\u0440\u0430\u0432\u0438 \u0432\u0430\u0440\u0438\u0458\u0430\u0446\u0438\u0458\u0435 \u043f\u043e\u043c\u043e\u045b\u0443 \u0412\u0418"],"Press '\/' for suggestions or describe the changes you want to apply (optional)...":["\u041f\u0440\u0438\u0442\u0438\u0441\u043d\u0438\u0442\u0435 \u201e\/\u201c \u0437\u0430 \u043f\u0440\u0435\u0434\u043b\u043e\u0433\u0435 \u0438\u043b\u0438 \u043e\u043f\u0438\u0448\u0438\u0442\u0435 \u0438\u0437\u043c\u0435\u043d\u0435 \u043a\u043e\u0458\u0435 \u0436\u0435\u043b\u0438\u0442\u0435 \u0434\u0430 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u0442\u0435 (\u043d\u0435\u043e\u0431\u0430\u0432\u0435\u0437\u043d\u043e)..."],"Warm hues with comforting visuals about":["\u0422\u043e\u043f\u043b\u0435 \u043d\u0438\u0458\u0430\u043d\u0441\u0435 \u0441\u0430 \u0443\u0442\u0435\u0448\u043d\u0438\u043c \u0432\u0438\u0437\u0443\u0435\u043b\u043d\u0438\u043c \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0438\u043c\u0430 \u043e"],"Tech-inspired style with modern fonts about":["\u0422\u0435\u0445\u043d\u043e\u043b\u043e\u0448\u043a\u0438 \u043d\u0430\u0434\u0430\u0445\u043d\u0443\u0442 \u0441\u0442\u0438\u043b \u0441\u0430 \u043c\u043e\u0434\u0435\u0440\u043d\u0438\u043c \u0441\u043b\u043e\u0432\u043d\u0438\u043c \u043b\u0438\u043a\u043e\u0432\u0438\u043c\u0430 \u043e"],"Luxurious theme with rich colors discussing":["\u041b\u0443\u043a\u0441\u0443\u0437\u043d\u0430 \u0442\u0435\u043c\u0430 \u0441\u0430 \u0431\u043e\u0433\u0430\u0442\u0438\u043c \u0431\u043e\u0458\u0430\u043c\u0430 \u043a\u043e\u0458\u0430 \u0433\u043e\u0432\u043e\u0440\u0438 \u043e"],"Earthy tones and organic shapes featuring":["\u0417\u0435\u043c\u0459\u0430\u043d\u0438 \u0442\u043e\u043d\u043e\u0432\u0438 \u0438 \u043e\u0440\u0433\u0430\u043d\u0441\u043a\u0438 \u043e\u0431\u043b\u0438\u0446\u0438 \u043a\u043e\u0458\u0438 \u043f\u0440\u0438\u043a\u0430\u0437\u0443\u0458\u0443"],"Professional look with clean lines for":["\u041f\u0440\u043e\u0444\u0435\u0441\u0438\u043e\u043d\u0430\u043b\u0430\u043d \u0438\u0437\u0433\u043b\u0435\u0434 \u0441\u0430 \u0447\u0438\u0441\u0442\u0438\u043c \u043b\u0438\u043d\u0438\u0458\u0430\u043c\u0430 \u0437\u0430"],"Futuristic design with neon accents about":["\u0424\u0443\u0442\u0443\u0440\u0438\u0441\u0442\u0438\u0447\u043a\u0438 \u0434\u0438\u0437\u0430\u0458\u043d \u0441\u0430 \u043d\u0435\u043e\u043d\u0441\u043a\u0438\u043c \u043d\u0430\u0433\u043b\u0430\u0441\u0446\u0438\u043c\u0430 \u043e"],"Retro vibe with muted colors and classic fonts about":["\u0420\u0435\u0442\u0440\u043e \u0434\u0443\u0445 \u0441\u0430 \u043f\u0440\u0438\u0433\u0443\u0448\u0435\u043d\u0438\u043c \u0431\u043e\u0458\u0430\u043c\u0430 \u0438 \u043a\u043b\u0430\u0441\u0438\u0447\u043d\u0438\u043c \u0441\u043b\u043e\u0432\u043d\u0438\u043c \u043b\u0438\u043a\u043e\u0432\u0438\u043c\u0430 \u043e"],"Elegant style with serif fonts discussing":["\u0415\u043b\u0435\u0433\u0430\u043d\u0442\u0430\u043d \u0441\u0442\u0438\u043b \u0441\u0430 \u0441\u0435\u0440\u0438\u0444\u043d\u0438\u043c \u0441\u043b\u043e\u0432\u043d\u0438\u043c \u043b\u0438\u043a\u043e\u0432\u0438\u043c\u0430 \u043a\u043e\u0458\u0438 \u0433\u043e\u0432\u043e\u0440\u0438 \u043e"],"Minimalist design with bold typography about":["\u041c\u0438\u043d\u0438\u043c\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u043a\u0438 \u0434\u0438\u0437\u0430\u0458\u043d \u0441\u0430 \u0443\u043f\u0430\u0434\u0459\u0438\u0432\u043e\u043c \u0442\u0438\u043f\u043e\u0433\u0440\u0430\u0444\u0438\u0458\u043e\u043c \u043e"],"Suggested Prompts":["\u041f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438 \u0443\u043f\u0438\u0442\u0438"],"The app is not responding. Please try again later. (#408)":["\u0410\u043f\u043b\u0438\u043a\u0430\u0446\u0438\u0458\u0430 \u043d\u0435 \u043e\u0434\u0433\u043e\u0432\u0430\u0440\u0430. \u041f\u043e\u043a\u0443\u0448\u0430\u0458\u0442\u0435 \u043f\u043e\u043d\u043e\u0432\u043e \u043a\u0430\u0441\u043d\u0438\u0458\u0435. (#408)"],"Craft your prompt to affect content, images and\/or colors - whichever you decide.":["\u0421\u0430\u0441\u0442\u0430\u0432\u0438\u0442\u0435 \u0441\u0432\u043e\u0458 \u0443\u043f\u0438\u0442 \u0442\u0430\u043a\u043e \u0434\u0430 \u0443\u0442\u0438\u0447\u0435 \u043d\u0430 \u0441\u0430\u0434\u0440\u0436\u0430\u0458, \u0441\u043b\u0438\u043a\u0435 \u0438\/\u0438\u043b\u0438 \u0431\u043e\u0458\u0435 - \u0448\u0442\u0430 \u0433\u043e\u0434 \u043e\u0434\u043b\u0443\u0447\u0438\u0442\u0435."],"You\u2019ve got the power.":["\u0412\u0438 \u0438\u043c\u0430\u0442\u0435 \u043c\u043e\u045b."],"Reference a website":["\u0423\u043f\u0443\u0442\u0438 \u043d\u0430 \u0432\u0435\u0431 \u0441\u0430\u0458\u0442"],"Your progress will be deleted, and can't be recovered.":["\u0412\u0430\u0448 \u043d\u0430\u043f\u0440\u0435\u0434\u0430\u043a \u045b\u0435 \u0431\u0438\u0442\u0438 \u0438\u0437\u0431\u0440\u0438\u0441\u0430\u043d \u0438 \u043d\u0435 \u043c\u043e\u0436\u0435 \u0441\u0435 \u043f\u043e\u0432\u0440\u0430\u0442\u0438\u0442\u0438."],"Minimize":["\u0423\u043c\u0430\u045a\u0438"],"Use Layout":["\u041a\u043e\u0440\u0438\u0441\u0442\u0438 \u0440\u0430\u0441\u043f\u043e\u0440\u0435\u0434"],"Regenerate":["\u041f\u043e\u043d\u043e\u0432\u043e \u043d\u0430\u043f\u0440\u0430\u0432\u0438"],"Preview unavailable":["\u041f\u0440\u0435\u0433\u043b\u0435\u0434 \u043d\u0438\u0458\u0435 \u0434\u043e\u0441\u0442\u0443\u043f\u0430\u043d"],"Press '\/' for suggested prompts or describe the layout you want to create":["\u041f\u0440\u0438\u0442\u0438\u0441\u043d\u0438\u0442\u0435 \u201e\/\u201c \u0437\u0430 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0435 \u0443\u043f\u0438\u0442\u0435 \u0438\u043b\u0438 \u043e\u043f\u0438\u0448\u0438\u0442\u0435 \u0440\u0430\u0441\u043f\u043e\u0440\u0435\u0434 \u043a\u043e\u0458\u0438 \u0436\u0435\u043b\u0438\u0442\u0435 \u0434\u0430 \u043d\u0430\u043f\u0440\u0430\u0432\u0438\u0442\u0435"],"Edit prompt":["\u0423\u0440\u0435\u0434\u0438 \u0443\u043f\u0438\u0442"],"Back to results":["\u041d\u0430\u0437\u0430\u0434 \u043d\u0430 \u0440\u0435\u0437\u0443\u043b\u0442\u0430\u0442\u0435"],"AI Layout":["AI \u0440\u0430\u0441\u043f\u043e\u0440\u0435\u0434"],"Access 30-days of AI History with the AI Starter plan and 90-days with the Power plan.":["\u041f\u0440\u0438\u0441\u0442\u0443\u043f\u0438\u0442\u0435 30 \u0434\u0430\u043d\u0430 \u0412\u0418 \u0438\u0441\u0442\u043e\u0440\u0438\u0458\u0435 \u0443\u0437 \u043f\u043b\u0430\u043d AI Starter \u0438 90 \u0434\u0430\u043d\u0430 \u0443\u0437 \u043f\u043b\u0430\u043d Power."],"Effortlessly create or enhance stunning images and bring your ideas to life.":["\u0411\u0435\u0437 \u043d\u0430\u043f\u043e\u0440\u0430 \u043f\u0440\u0430\u0432\u0438\u0442\u0435 \u0438\u043b\u0438 \u043f\u043e\u0431\u043e\u0459\u0448\u0430\u0432\u0430\u0458\u0442\u0435 \u0437\u0430\u0434\u0438\u0432\u0459\u0443\u0458\u0443\u045b\u0435 \u0441\u043b\u0438\u043a\u0435 \u0438 \u043e\u0436\u0438\u0432\u0438\u0442\u0435 \u0441\u0432\u043e\u0458\u0435 \u0438\u0434\u0435\u0458\u0435."],"Upgrade now":["\u041d\u0430\u0434\u043e\u0433\u0440\u0430\u0434\u0438 \u0441\u0430\u0434\u0430"],"Build with AI":["\u0413\u0440\u0430\u0434\u0438 \u043f\u043e\u043c\u043e\u045b\u0443 \u0412\u0418"],"Expand":["\u041f\u0440\u043e\u0448\u0438\u0440\u0438"],"Seems like the prompt contains words that could generate harmful content. Write a different prompt to continue.":["\u0418\u0437\u0433\u043b\u0435\u0434\u0430 \u0434\u0430 \u0443\u043f\u0438\u0442 \u0441\u0430\u0434\u0440\u0436\u0438 \u0440\u0435\u0447\u0438 \u043a\u043e\u0458\u0435 \u0431\u0438 \u043c\u043e\u0433\u043b\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u0438\u0442\u0438 \u0448\u0442\u0435\u0442\u0430\u043d \u0441\u0430\u0434\u0440\u0436\u0430\u0458. \u041d\u0430\u043f\u0438\u0448\u0438\u0442\u0435 \u0434\u0440\u0443\u0433\u0438 \u0443\u043f\u0438\u0442 \u0434\u0430 \u0431\u0438\u0441\u0442\u0435 \u043d\u0430\u0441\u0442\u0430\u0432\u0438\u043b\u0438."],"We were unable to generate that prompt.":["\u041d\u0438\u0441\u043c\u043e \u043c\u043e\u0433\u043b\u0438 \u0434\u0430 \u043e\u0431\u0440\u0430\u0434\u0438\u043c\u043e \u0442\u0430\u0458 \u0443\u043f\u0438\u0442."],"Reconnect":["\u041f\u043e\u043d\u043e\u0432\u043e \u043f\u043e\u0432\u0435\u0436\u0438"],"Generate":["\u041d\u0430\u043f\u0440\u0430\u0432\u0438"],"Enhance prompt":["\u041f\u043e\u0431\u043e\u0459\u0448\u0430\u0458 \u0443\u043f\u0438\u0442"],"Yes, leave":["\u0414\u0430, \u043d\u0430\u043f\u0443\u0441\u0442\u0438"],"Leave Elementor AI?":["\u041d\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0438 Elementor \u0412\u0418?"],"Upgrade Elementor AI":["\u041d\u0430\u0434\u043e\u0433\u0440\u0430\u0434\u043