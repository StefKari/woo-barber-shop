\u043e\u0432\u0430\u0440\u0430\u0458\u0443\u045b\u0438\u043c \u0434\u0438\u0437\u0430\u0458\u043d\u0438\u043c\u0430, \u0440\u0430\u0441\u043f\u043e\u0440\u0435\u0434\u0438\u043c\u0430 \u0438 \u0441\u0430\u0434\u0440\u0436\u0430\u0458\u0435\u043c \u0437\u0430 \u0432\u0430\u0448\u0435 \u043f\u043e\u0441\u043b\u043e\u0432\u0430\u045a\u0435."],"Get improved results from AI by adding personal context.":["\u0414\u043e\u0431\u0438\u0458\u0442\u0435 \u0431\u043e\u0459\u0435 \u0440\u0435\u0437\u0443\u043b\u0442\u0430\u0442\u0435 \u043e\u0434 \u0412\u0418 \u0434\u043e\u0434\u0430\u0432\u0430\u045a\u0435\u043c \u043b\u0438\u0447\u043d\u043e\u0433 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0430."],"Please upload a file that is less than 4MB.":["\u041e\u0442\u043f\u0440\u0435\u043c\u0438\u0442\u0435 \u0434\u0430\u0442\u043e\u0442\u0435\u043a\u0443 \u043c\u0430\u045a\u0443 \u043e\u0434 4MB."],"The file is too large.":["\u0414\u0430\u0442\u043e\u0442\u0435\u043a\u0430 \u0458\u0435 \u043f\u0440\u0435\u0432\u0435\u043b\u0438\u043a\u0430."],"Ready to take it to the next level?":["\u0421\u043f\u0440\u0435\u043c\u043d\u0438 \u0434\u0430 \u043f\u0440\u0435\u0452\u0435\u0442\u0435 \u043d\u0430 \u0432\u0438\u0448\u0438 \u043d\u0438\u0432\u043e?"],"Looks like you're out of credits.":["\u0418\u0437\u0433\u043b\u0435\u0434\u0430 \u0434\u0430 \u0441\u0442\u0435 \u043f\u043e\u0442\u0440\u043e\u0448\u0438\u043b\u0438 \u043a\u0440\u0435\u0434\u0438\u0442\u0435."],"Try exiting Elementor and sign in again.":["\u041f\u043e\u043a\u0443\u0448\u0430\u0458\u0442\u0435 \u0434\u0430 \u0438\u0437\u0430\u0452\u0435\u0442\u0435 \u0438\u0437 Elementor-\u0430 \u0438 \u043f\u043e\u043d\u043e\u0432\u043e \u0441\u0435 \u043f\u0440\u0438\u0458\u0430\u0432\u0438\u0442\u0435."],"Wait a moment and give it another go.":["\u0421\u0430\u0447\u0435\u043a\u0430\u0458\u0442\u0435 \u0442\u0440\u0435\u043d\u0443\u0442\u0430\u043a \u0438 \u043f\u043e\u043a\u0443\u0448\u0430\u0458\u0442\u0435 \u043f\u043e\u043d\u043e\u